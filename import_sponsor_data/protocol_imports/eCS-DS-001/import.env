# Environment for importing protocol eCS-DS-001. Paths are relative to
# import_sponsor_data/, which is where the commands in README.md run.

API_BASE_URL="http://localhost:8000"

# Authentication, when OAuth is enabled on the target: either client
# credentials or a bearer token.
#CLIENT_ID=""
#CLIENT_SECRET=""
#TOKEN_ENDPOINT=""
#SCOPE=""
#STUDYBUILDER_API_TOKEN=""

LOG_LEVEL=INFO

# mockdatajson step
IMPORT_PROJECTS="protocol_imports/eCS-DS-001/exported/projects.json"
MDR_MIGRATION_FROM_SAME_ENV=False
MDR_MIGRATION_EXPORTED_PROGRAMMES=True
MDR_MIGRATION_EXPORTED_DICTIONARIES=True
MDR_MIGRATION_EXPORTED_ACTIVITIES=True
MDR_MIGRATION_EXPORTED_TEMPLATES=True
MDR_MIGRATION_EXPORTED_PROJECTS=True
MDR_MIGRATION_EXPORTED_STUDIES=True
# Not used by this protocol
MDR_MIGRATION_EXPORTED_BRANDS=False
MDR_MIGRATION_EXPORTED_UNITS=False
MDR_MIGRATION_EXPORTED_CONCEPT_VALUES=False
MDR_MIGRATION_EXPORTED_ACTIVITY_INSTANCES=False
# Lumavant is created by the compounds step instead, which also creates the
# medicinal product a study compound needs.
MDR_MIGRATION_EXPORTED_COMPOUNDS=False

# compounds step
MDR_MIGRATION_ACTIVE_SUBSTANCES="protocol_imports/eCS-DS-001/compounds/active_substances.json"
MDR_MIGRATION_PHARMACEUTICAL_PRODUCTS="protocol_imports/eCS-DS-001/compounds/pharmaceutical_products.json"
MDR_MIGRATION_COMPOUNDS="protocol_imports/eCS-DS-001/compounds/compounds.json"
MDR_MIGRATION_MEDICINAL_PRODUCTS="protocol_imports/eCS-DS-001/compounds/medicinal_products.json"
